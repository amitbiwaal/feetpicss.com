# Copy this file to .env.local and fill in real values.
# On Vercel these are set in the project's Environment Variables instead.

# Public address of the site (no trailing slash). Used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://feetpicss.com

# Admin panel login (/admin). The password must be at least 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Random secret (32+ characters) used to sign admin sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Storage -----------------------------------------------------------------------------
# Leave these unset for local development: posts, messages and uploads then live in ./content
# and nothing touches production.
# On Vercel they are provided by the Turso integration and the Blob store.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# BLOB_READ_WRITE_TOKEN=

# Optional: where the local-development content folder is. Defaults to ./content
# CONTENT_DIR=
