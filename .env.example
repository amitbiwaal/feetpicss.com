# Copy this file to .env.local and fill in real values.

# Public address of the site (no trailing slash). Used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://feetpicss.com

# Admin panel login (/admin). The password must be at least 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Random secret (32+ characters) used to sign admin sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional: where posts, messages and uploads are stored. Defaults to ./content
# CONTENT_DIR=
